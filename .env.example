# COREMAN Environment Configuration
SECRET_KEY=replace-with-a-long-random-secret

# Admin Credentials
COREMAN_ADMIN_USERNAME=admin
COREMAN_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Database Connection (Supabase PostgreSQL or SQLite)
# For Supabase PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/postgres
# For local SQLite fallback (leave blank or specify sqlite path):
# DATABASE_URL=sqlite:///coreman.db

# Email settings for SMTP confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com

# Payment provider settings
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COREMAN_COD_ONLY=false
