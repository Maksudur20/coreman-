SECRET_KEY=replace-with-a-long-random-secret
COREMAN_ADMIN_USERNAME=admin
COREMAN_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Email settings for real SMTP confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com

# For a live payment flow, choose one provider and add its credentials.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

